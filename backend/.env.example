# Application
ENVIRONMENT=development
SECRET_KEY=generate_64_char_hex_string_with_openssl
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/vendorbridge
DATABASE_TEST_URL=postgresql://postgres:password@localhost:5432/vendorbridge_test

# JWT Configuration
JWT_SECRET_KEY=generate_64_char_hex_string_with_openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://localhost:5173"]

# Application URLs
APP_BASE_URL=http://localhost:5500

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@vendorbridge.com
BREVO_SENDER_NAME=VendorBridge

# Company Information
COMPANY_NAME=VendorBridge
COMPANY_ADDRESS=123 Business Park, Mumbai, India 400001
COMPANY_PHONE=+91-9876543210
COMPANY_EMAIL=contact@vendorbridge.com
COMPANY_GSTIN=27AABCU9603R1Z0

# Storage Paths
PDF_STORAGE_PATH=generated_pdfs
UPLOAD_STORAGE_PATH=uploads

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf",".doc",".docx",".xls",".xlsx"]

# Tax Configuration
TAX_RATE=18.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Redis (optional for production)
REDIS_URL=redis://localhost:6379
