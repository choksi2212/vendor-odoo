# ─────────────────────────────────────────────
#  Arial Sense — .gitignore
#  NEVER push credentials, secrets, or venvs.
# ─────────────────────────────────────────────


# ── Credentials & Secrets ─────────────────────
# These contain DB passwords, JWT secrets, email app passwords, etc.
.env
backend/.env
*.env

# ── Virtual Environments ──────────────────────
arial/
.venv/
venv/
env/
ENV/
backend/.venv/

# ── Python Cache ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribution / Build ──────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Pytest / Testing ──────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Alembic ───────────────────────────────────
# Keep migrations and config, but not local override files
backend/alembic/versions/*.pyc

# ── Logs ──────────────────────────────────────
*.log
logs/

# ── DB reset utility (contains destructive SQL) ──
reset.py

# ── IDE & Editor ──────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# ── OS Generated ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporary files ───────────────────────────
*.tmp
*.bak
*.swp
*~
