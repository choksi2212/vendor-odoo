# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/arial_sense

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# CSV or JSON array — trailing slashes are stripped automatically
ALLOWED_ORIGINS=https://yourfrontend.vercel.app,http://localhost:3000,http://localhost:5500

# ── Frontend base URL (used to build links inside emails) ────────────────────
APP_BASE_URL=https://yourfrontend.vercel.app

# ── Email — Brevo HTTP API (free, no SMTP, works on Railway) ─────────────────
# Sign up at brevo.com → verify a sender email → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=you@gmail.com          # must be a verified sender in Brevo
MAIL_FROM_NAME=Arial Sense

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Required only when running multiple workers. Falls back to in-memory if unset.
REDIS_URL=
